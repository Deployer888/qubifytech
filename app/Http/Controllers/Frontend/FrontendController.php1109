    /**
     * Get all services page sections from database
     *
     * @param \Modules\DynamicPage\Entities\Page $servicesPage
     * @return array
     */
    private function getServicesSections($servicesPage)
    {
        // Fetch all active sections for the services page ordered by their order_by field
        $sections = $servicesPage->activeDynamicContents()
            ->get()
            ->keyBy('section_name');

        // Return individual sections for easy access in views
        return [
            'pageContent' => $servicesPage,
            'heroContent' => $sections->get('hero'),
            'introContent' => $sections->get('intro'),
            'coreServicesContent' => $sections->get('core_services'),
            'additionalServicesContent' => $sections->get('additional_services'),
            'ctaContent' => $sections->get('cta'),
            'allSections' => $sections, // For any additional processing
        ];
    }
