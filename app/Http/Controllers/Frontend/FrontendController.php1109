    /**
     * Retrieves the view for the index page of the frontend.
     *
     * @return \Illuminate\Contracts\View\View
     */
    public function index()
    {
         // Check if the authenticated user has the 'admin' role
        if (auth()->check() && auth()->user()->roles->contains('name', 'super admin')) {
            return redirect()->route('backend.dashboard');
        }
        
        // Fetch all dynamic content sections for the homepage

        $dynamicSections = $this->getHomepageSections();

        $seo = CustomSeo::where('page_id', 1)->where('page_type_id', 1)->first();
        return view('frontend.index', array_merge(
            $dynamicSections,
            ['seo' => $seo]
        ));
    }

    public function services()
    {
        // Get the services page from database
        $dynamicContents = DynamicContent::where('page_id', 4)
            ->where('page_type_id', 4)
            ->active()
            ->ordered()
            ->get()
            ->keyBy('section_name');
       
        // Organize sections for easy access in views
        $sections = [
            'heroContent' => $dynamicContents->get('hero'),
            'servicesHeaderContent' => $dynamicContents->get('services_header'),
            'webDevelopmentContent' => $dynamicContents->get('web_development'),
            'softwareDevelopmentContent' => $dynamicContents->get('software_development'),
            'mobileDevelopmentContent' => $dynamicContents->get('mobile_development'),
            'webAppDevelopmentContent' => $dynamicContents->get('web_app_development'),
            'whyQubifyContent' => $dynamicContents->get('why_qubify'),
            'technologiesContent' => $dynamicContents->get('technologies'),
            'ctaContent' => $dynamicContents->get('cta'),
        ];
        $seo = CustomSeo::where('page_id', 4)->where('page_type_id', 4)->first();
        return view('frontend.services.index', array_merge(
            $sections,
            ['seo' => $seo]
        ));
    }

    /**
     * Get all homepage sections from database
     *
     * @return array
     */
    private function getHomepageSections()
    {
        // Fetch all active sections ordered by their order_by field
 
        $sections = DynamicContent::where('page_id', 1)
        ->where('page_type_id', 1)
        ->active()
        ->ordered()
        ->get()
        ->keyBy('section_name');

        // Return individual sections for easy access in views
        return [
            'heroContent' => $sections->get('hero'),
            'aboutContent' => $sections->get('about'),
            'servicesContent' => $sections->get('services'),
            'solutionsContent' => $sections->get('solutions'),
            'portfolioContent' => $sections->get('portfolio'),
            'testimonialsContent' => $sections->get('testimonials'),
            'ctaContent' => $sections->get('cta'),
            'contactContent' => $sections->get('contact'),
            'allSections' => $sections, // For any additional processing
        ];
    }

    public function submit(Request $request)
    {
        // Log the incoming request for debugging
        \Log::info('Contact form submission data:', $request->all());
        
        // Validate the form data
        $validator = Validator::make($request->all(), [
            'uname' => 'required|string|max:255',
            'email' => 'required|email|max:255',
            'phone' => 'nullable|string|max:20',
            'solution' => 'nullable|string',
            'budget' => 'nullable|string',
            'message' => 'required|string|max:2000',
        ], [
            'uname.required' => 'Full name is required.',
            'uname.max' => 'Full name must not exceed 255 characters.',
            'email.required' => 'Email address is required.',
            'email.email' => 'Please enter a valid email address.',
            'email.max' => 'Email must not exceed 255 characters.',
            'phone.max' => 'Phone number must not exceed 20 characters.',
            'message.required' => 'Message is required.',
            'message.max' => 'Message must not exceed 2000 characters.',
        ]);

        // Return validation errors if any
        if ($validator->fails()) {
            \Log::warning('Contact form validation failed:', $validator->errors()->toArray());
            return redirect()->back()
                ->withErrors($validator)
                ->withInput()
                ->with('error', 'Please check the form and fix the errors.');
        }

        try {
            $formData = $validator->validated();
            
            // Additional validation to ensure email is actually an email
            $userEmail = filter_var($formData['email'], FILTER_VALIDATE_EMAIL);
            if (!$userEmail) {
                \Log::error('Invalid email format after validation:', ['email' => $formData['email']]);
                return redirect()->back()
                    ->withInput()
                    ->with('error', 'Please enter a valid email address.');
            }
            
            // Clean and sanitize the data
            $cleanData = [
                'uname' => trim(strip_tags($request->uname)),
                'email' => trim(strtolower($request->email)),
                'phone' => $request->phone ? trim(strip_tags($request->phone)) : null,
                'solution' => $request->solution ? trim(strip_tags($request->solution)) : null,
                'budget' => $request->budget ? trim(strip_tags($request->budget)) : null,
                'message' => trim(strip_tags($request->message)),
            ];

            \Log::info('Sending emails with clean data:', [
                'admin_email' => 'abhishek@qubifytech.com',
                'user_email' => $cleanData['email'],
                'user_name' => $cleanData['uname']
            ]);

            // Send emails
            $this->sendContactEmails($cleanData);
            
            \Log::info('Contact form emails sent successfully');
            
            return redirect()->back()->with('success', 'Thank you for your message! We\'ll get back to you within 24 hours.');
            
        } catch (\Exception $e) {
        dd($e->getMessage());
            \Log::error('Contact form submission error: ' . $e->getMessage(), [
                'file' => $e->getFile(),
                'line' => $e->getLine(),
                'trace' => $e->getTraceAsString()
            ]);
            
            return redirect()->back()
                ->withInput()
                ->with('error', 'Sorry, there was an error sending your message. Please try again later.');
        }
    }

    /**
     * Send contact form emails to admin and user
     *
     * @param array $cleanData
     * @throws \Exception
     */
    private function sendContactEmails(array $cleanData)
    {
        try {
            // Send email to admin using ContactFormMail mailable
            Mail::to('chitranshu@qubifytech.com')->send(new ContactFormMail($cleanData));
            Mail::to('abhishek  @qubifytech.com')->send(new ContactFormMail($cleanData));

            // Send confirmation email to user using ContactConfirmationMail mailable
            Mail::to($cleanData['email'])->send(new ContactConfirmationMail($cleanData));
            
        } catch (\Exception $mailException) {
            \Log::error('Failed to send emails: ' . $mailException->getMessage());
            throw $mailException;
        }
    }
    
